rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agent-owned application data is server-authoritative. Firebase Admin SDK
    // uses IAM and bypasses these client rules; browsers must use authenticated
    // REST endpoints so RBAC/module policy has one enforcement point.
    match /agent_memories/{id} {
      allow read, write: if false;
    }

    match /agent_tasks/{id} {
      allow read, write: if false;
    }

    match /users/{userId}/credentials/{id} {
      allow read, write: if false;
    }

    match /user_files/{id} {
      allow read, write: if false;
    }

    match /agent_sessions/{id} {
      allow read, write: if false;
    }

    match /capability_confirmations/{id} {
      allow read, write: if false;
    }

    match /audit_logs/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
